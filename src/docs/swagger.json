"/api/student-academic-history/promotion-list": {
  "get": {
    "summary": "Promotion Student List API",
    "tags": [
      "Student Promotion"
    ],
    "parameters": [
      {
        "name": "academic_year_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Current academic year ID"
      },
      {
        "name": "class_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Current class ID"
      }
    ],
    "responses": {
      "200": {
        "description": "Students available for promotion"
      }
    }
  }
},


"/api/student-academic-history/promote": {
  "post": {
    "summary": "Promote Students API",
    "tags": [
      "Student Promotion"
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "student_ids",
              "from_academic_year_id",
              "to_academic_year_id",
              "to_class_id"
            ],
            "properties": {
              "student_ids": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "example": [
                  1,
                  2,
                  3
                ]
              },
              "from_academic_year_id": {
                "type": "integer",
                "example": 1
              },
              "to_academic_year_id": {
                "type": "integer",
                "example": 2
              },
              "to_class_id": {
                "type": "integer",
                "example": 24
              },
              "promoted_date": {
                "type": "string",
                "format": "date",
                "example": "2027-04-01"
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Students promoted successfully"
      },
      "400": {
        "description": "Invalid promotion data"
      }
    }
  }
},
