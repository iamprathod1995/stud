"/api/academic-years": {
  "get": {
    "summary": "Academic Year List API with Pagination, Search and Sorting",
    "tags": [
      "Academic Years"
    ],
    "parameters": [
      {
        "name": "search",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Search academic year"
      },
      {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1
        }
      },
      {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 10
        }
      },
      {
        "name": "sortBy",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "year_name",
            "start_date",
            "end_date",
            "created_at"
          ]
        }
      },
      {
        "name": "sortOrder",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "ASC",
            "DESC"
          ]
        }
      }
    ],
    "responses": {
